# === Moodle Credentials ===
MOODLE_URL=https://moodle.youruni.edu
MOODLE_USERNAME=your_student_id
MOODLE_PASSWORD=your_password

# === Discord Webhook ===
# Go to your Discord server → channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# === Database (Neon Postgres) ===
# Neon dashboard -> Connect -> copy the connection string (keep ?sslmode=require).
# The pooled (-pooler) string is recommended.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# === Optional ===
CHECK_INTERVAL_SECONDS=1800
TIMEZONE=Africa/Cairo
